{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "outDir": "daemon/dist",
    "rootDir": "."
  },
  "include": [
    "daemon/src",
    "daemon/testing",
    "vitest.config.ts",
    "docker/*.ts",
    "daemon/*.ts",
    "test"
  ],
  "exclude": ["node_modules", "daemon/dist"]
}
