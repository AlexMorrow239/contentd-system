{
  "name": "brainrot-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p remotion --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "CONTRACT=1 vitest run",
    "test:storage": "STORAGE=1 vitest run",
    "brainrot": "tsx src/cli.ts"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "tabWidth": 2,
    "printWidth": 100,
    "embeddedLanguageFormatting": "off"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@hono/node-server": "^2.0.11",
    "@remotion/bundler": "^4.0.491",
    "@remotion/cli": "^4.0.491",
    "@remotion/renderer": "^4.0.491",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^10.0.0",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.12.32",
    "kokoro-js": "^1.2.1",
    "msedge-tts": "^2.0.7",
    "nanoid": "^6.0.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.491",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
