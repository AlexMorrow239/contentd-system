{
  "name": "brainrot-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p integrations/remotion --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "CONTRACT=1 vitest run",
    "brainrot": "tsx daemon/src/cli.ts",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm dashboard:build && pnpm test",
    "test:config": "vitest run daemon/src/config",
    "test:pipeline": "vitest run daemon/src/jobs daemon/src/stages integrations/remotion",
    "test:scout": "vitest run daemon/src/scout",
    "dashboard:dev": "tsx scripts/dashboard.ts dev",
    "dashboard:build": "next build dashboard --webpack",
    "dashboard:start": "tsx scripts/dashboard.ts start",
    "test:dashboard": "playwright test --config dashboard/playwright.config.ts"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "tabWidth": 2,
    "printWidth": 100,
    "embeddedLanguageFormatting": "off"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@remotion/bundler": "^4.0.491",
    "@remotion/cli": "^4.0.491",
    "@remotion/renderer": "^4.0.491",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^10.0.0",
    "nanoid": "^6.0.0",
    "next": "16.3.6",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.491",
    "server-only": "^0.0.1",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
