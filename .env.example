# Production settings consumed explicitly by docker-compose.yml.
# Development uses pnpm test; no local daemon/root/channel copy is needed.
ANTHROPIC_API_KEY=
# Optional premium voice; missing/failed synthesis falls back to kokoro/edge-tts.
ELEVENLABS_API_KEY=
LOG_LEVEL=info
# Shared by daemon enforcement and the dashboard spend panel.
BRAINROT_GLOBAL_DAILY_USD=12
# WhisperX upload cap in MB. Compose supplies the internal sidecar URL.
WHISPERX_MAX_UPLOAD_MB=64

# Optional Cloudflare R2 archive, bucket: brainrot-videos.
# Compose maps these to the runtime's BRAINROT_S3_* interface.
# Leave all three empty to keep videos only in docker/state/runs/.
BRAINROT_R2_ENDPOINT=
BRAINROT_R2_ACCESS_KEY_ID=
BRAINROT_R2_SECRET_ACCESS_KEY=

# Storage tests use local MinIO defaults, independent of production settings.
# Optional TEST_S3_ENDPOINT / TEST_S3_BUCKET / TEST_S3_ACCESS_KEY_ID /
# TEST_S3_SECRET_ACCESS_KEY overrides belong in the test command's environment.
