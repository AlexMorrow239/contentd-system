ANTHROPIC_API_KEY=
WHISPERX_URL=http://localhost:8585
# WhisperX sidecar upload cap in MB (max narration audio the sidecar accepts)
WHISPERX_MAX_UPLOAD_MB=64
BRAINROT_DB=data/brainrot.db
LOG_LEVEL=info
# fal.ai API key — premium visuals (FLUX keyframes, Kling/MiniMax image-to-video)
FAL_KEY=
# ElevenLabs API key — premium voice; unset or failing falls back to kokoro/edge-tts
ELEVENLABS_API_KEY=
# OPTIONAL. Reddit app-only OAuth for the scout, if you get a script app
# approved (reddit.com/prefs/apps — app creation is gated behind Reddit's
# Responsible Builder Policy). Unset is fully supported: subreddits are read
# through their public .rss feeds instead. Setting these upgrades the scout to
# the JSON API (mod stickies filtered, 100 req/min).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Operator safety net: cross-channel daily spend cap in USD (default 25)
BRAINROT_GLOBAL_DAILY_USD=25
