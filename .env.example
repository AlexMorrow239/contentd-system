# Production settings consumed explicitly by docker-compose.yml.
# Development uses pnpm test; no local daemon/root/channel copy is needed.
ANTHROPIC_API_KEY=
# Required for voice synthesis. Missing credentials or provider failures fail the job.
ELEVENLABS_API_KEY=
LOG_LEVEL=info
# Shared by daemon enforcement and the dashboard spend panel.
BRAINROT_GLOBAL_DAILY_USD=12
# WhisperX upload cap in MB. Compose supplies the internal sidecar URL.
WHISPERX_MAX_UPLOAD_MB=64
