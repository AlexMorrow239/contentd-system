ANTHROPIC_API_KEY=
WHISPERX_URL=http://localhost:8585
# WhisperX upload cap in MB (max narration audio the sidecar accepts). Enforced
# by the sidecar itself; docker-compose passes this value through to it.
WHISPERX_MAX_UPLOAD_MB=64
# --- Development copy ---------------------------------------------------
# These three point the HOST cli at development state. The container overrides
# all three with production values in docker-compose.yml, so a bare
# `pnpm brainrot ...` on this machine cannot read or write production.
# Promotion is a copy plus the auth step:
#   cp channels-dev/<name>.toml channels/<name>.toml
#   BRAINROT_DB=data/brainrot.db BRAINROT_CHANNELS_DIR=channels \
#     pnpm brainrot auth youtube --channel <name>
BRAINROT_DB=data/dev.db
BRAINROT_CHANNELS_DIR=channels-dev
BRAINROT_RUNS_ROOT=runs-dev
LOG_LEVEL=info
# ElevenLabs API key — premium voice; unset or failing falls back to kokoro/edge-tts
ELEVENLABS_API_KEY=
# Instagram (Meta) app credentials — the app's Instagram App ID/Secret from
# the "Instagram > API setup with Instagram login" page of the App
# Dashboard (NOT the Facebook App ID shown at the top of the dashboard —
# that belongs to a different login product). App in development mode with
# the operator added as an Instagram tester. Required only for
# `brainrot auth instagram`.
IG_APP_ID=
IG_APP_SECRET=
# Set to 1 to force the cheap voice chain (kokoro/edge-tts) for local runs,
# skipping ElevenLabs even when a channel's [voice.premium] is configured.
# `produce --dev` / `resume --dev` set this for you; a channel's own
# [voice] dev = true does the same without touching the environment.
BRAINROT_DEV_VOICE=
# Operator safety net: cross-channel daily spend cap in USD (default 25)
BRAINROT_GLOBAL_DAILY_USD=25
# Instagram upload cap per IG account per day (default 25, half Meta's
# documented ~50/24h — the halving absorbs the rolling-24h-vs-calendar-day
# mismatch at day boundaries; slots are the real limiter in practice)
# BRAINROT_IG_UPLOADS_PER_DAY=25
# Dashboard: db file read when a page is loaded with ?db=dev (default data/dev.db)
# BRAINROT_DEV_DB=data/dev.db
# Dashboard: port the read-only web dashboard listens on (default 8787)
# BRAINROT_DASHBOARD_PORT=8787
# --- Object storage (Cloudflare R2) -----------------------------------------
# Finished videos live here; Instagram publishes from a presigned URL because
# Meta fetches the video itself (graph.instagram.com rejects direct uploads).
# Create a bucket and an R2 API token with Object Read & Write.
# REQUIRED to produce, YouTube-only setups included: the stored copy is the
# durable one and runs/ is a disposable cache, so there is no local fallback.
# Unset, `produce` exits 1 and `produce-next` no-ops "bad-env" before rendering.
BRAINROT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BRAINROT_S3_BUCKET=brainrot-videos
BRAINROT_S3_ACCESS_KEY_ID=
BRAINROT_S3_SECRET_ACCESS_KEY=
# R2 ignores region but the SDK requires one. Leave as 'auto' for R2.
BRAINROT_S3_REGION=auto
# Local MinIO ONLY. Presigned URLs are signed against this host instead of the
# endpoint above, so a URL signed inside Compose is fetchable from your Mac.
# MUST be empty in production.
BRAINROT_S3_PUBLIC_ENDPOINT=
