ANTHROPIC_API_KEY=
WHISPERX_URL=http://localhost:8585
# WhisperX upload cap in MB (max narration audio the sidecar accepts). Enforced
# by the sidecar itself; docker-compose passes this value through to it.
WHISPERX_MAX_UPLOAD_MB=64
# --- Mode root ------------------------------------------------------------
# ONE variable decides where all state lives: <root>/db/brainrot.db,
# <root>/runs/, <root>/channels/. `local` is the development root and is also
# the built-in default, so a bare `pnpm brainrot ...` on this machine cannot
# reach production even with no .env at all. docker-compose.yml pins the
# container to /app/state.
#
# Promotion is a plain copy — there is no credential grant step, since
# nothing in this codebase authenticates against a platform:
#   cp local/channels/<name>.toml prod/channels/<name>.toml
BRAINROT_ROOT=local
LOG_LEVEL=info
# ElevenLabs API key — premium voice; unset or failing falls back to kokoro/edge-tts
ELEVENLABS_API_KEY=
# Set to 1 to force the cheap voice chain (kokoro/edge-tts) for local runs,
# skipping ElevenLabs even when a channel's [voice.premium] is configured.
# `produce --dev` / `resume --dev` set this for you; a channel's own
# [voice] dev = true does the same without touching the environment.
BRAINROT_DEV_VOICE=
# Operator safety net: cross-channel daily spend cap in USD (default 25)
BRAINROT_GLOBAL_DAILY_USD=25
# Dashboard: port the read-only web dashboard listens on (default 8787)
# BRAINROT_DASHBOARD_PORT=8787
# --- Object storage (Cloudflare R2) -----------------------------------------
# OPTIONAL. Finished videos are archived here by the `store` stage; posting
# itself is manual now (see README's "Posting a video"), so nothing requires
# this to be reachable off-machine. Left unset, `store` simply no-ops and
# logs it — `produce` still finishes normally, it just has no cloud copy:
# the video lives ONLY under runs/, and deleting that later is a real,
# unrecoverable deletion rather than clearing a cache of a durable copy.
# Configure it for a durable copy independent of the render machine's disk,
# or to post from a different machine than the one that rendered.
# Create a bucket and an R2 API token with Object Read & Write.
#
# BRAINROT_S3_* below is what the HOST CLI uses directly (src/storage/config.ts
# reads these names regardless of environment) — point it at local MinIO, see
# "Local MinIO" below.
BRAINROT_S3_ENDPOINT=http://localhost:9100
BRAINROT_S3_BUCKET=brainrot-videos
BRAINROT_S3_ACCESS_KEY_ID=
BRAINROT_S3_SECRET_ACCESS_KEY=
# R2 ignores region but the SDK requires one. Leave as 'auto' for R2.
BRAINROT_S3_REGION=auto
# Local MinIO ONLY. Presigned URLs are signed against this host instead of the
# endpoint above, so a URL signed inside Compose is fetchable from your Mac.
# MUST be empty in production.
BRAINROT_S3_PUBLIC_ENDPOINT=

# Production Cloudflare R2 credentials — used ONLY by the `brainrot` container.
# docker-compose.yml's `brainrot` service maps these onto BRAINROT_S3_* inside
# the container, so the host CLI keeps using MinIO (above) while the container
# gets real R2. Bucket name and region aren't here: bucket is pinned to
# `brainrot-videos` and region to 'auto' directly in docker-compose.yml.
BRAINROT_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BRAINROT_R2_ACCESS_KEY_ID=
BRAINROT_R2_SECRET_ACCESS_KEY=
