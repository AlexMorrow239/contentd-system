# python sidecar (local test venv + caches; real deps live in the Docker image)
.venv/
__pycache__/
.pytest_cache/
assets/bg/*
assets/bgm/*
!assets/bg/.gitkeep
!assets/bgm/.gitkeep

# Local e2e scratch: sqlite db + throwaway channel fixtures
sandbox/

logs/
superpowers/

# Legacy local state is retired. Keep it ignored on older checkouts so
# historical databases are never accidentally committed.
local/

# Accidental host runtime state; production SQLite lives in a Docker volume.
/db/

# docker/state/ is the host side of the containers' /app/state binds.
# docker/state/channels/ IS tracked (it is the live channel config);
# docker/state/runs/ is disposable render output. The database is not here:
# it lives in the brainrot-data named volume (see docker-compose.yml).
docker/state/runs/

**/.next/
**/*.tsbuildinfo
playwright-report/
test-results/

# Generated by Next.js
dashboard/next-env.d.ts
