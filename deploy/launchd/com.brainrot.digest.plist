<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brainrot.digest</string>

  <!-- Daily report at 08:00 local. This is the ONLY routine signal that a
       job failed, a topic is stranded, or a video is stuck in needs-review:
       the pipeline is otherwise silent on failure and nothing auto-recovers.
       Read it. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>brainrot</string>
    <string>digest</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/alex/code/project-brainrot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Appended, not truncated: the digest is the historical record. -->
  <key>StandardOutPath</key>
  <string>/Users/alex/code/project-brainrot/logs/digest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/code/project-brainrot/logs/digest.log</string>

  <!-- No ProcessType: Background defers timers while the session is idle. -->
</dict>
</plist>
