<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brainrot.produce-next</string>

  <!-- One unit of production per tick. StartInterval rather than a calendar
       list: launchd coalesces firings missed while asleep into a single run
       at wake, which is exactly right for an idempotent one-job-per-tick
       command. RunAtLoad is false so installing the agent does not kick off
       a render immediately. -->
  <key>StartInterval</key>
  <integer>1500</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>brainrot</string>
    <string>produce-next</string>
  </array>

  <!-- Required: dotenv, channels/, data/brainrot.db, runs/ and logs/ all
       resolve relative to the repo root. -->
  <key>WorkingDirectory</key>
  <string>/Users/alex/code/project-brainrot</string>

  <!-- launchd does not inherit a login shell, so pnpm/node/ffmpeg would not
       resolve without this. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/alex/code/project-brainrot/logs/produce-next.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/code/project-brainrot/logs/produce-next.log</string>

  <!-- A render can outlast the default nice level's patience under load. -->
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
