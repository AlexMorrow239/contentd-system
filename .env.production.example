# Production object storage (Cloudflare R2), loaded ONLY by the container.
#
# docker-compose.yml's `brainrot` service reads `.env` then this file, and a
# duplicate key here wins. That is what lets the host .env stay pointed at the
# local MinIO container — matching the dev triple it already carries for
# db/runs/channels — without swapping credentials back and forth.
#
# Copy to .env.production (gitignored) and fill in. The bucket name is NOT here:
# it is pinned to `brainrot-videos` in docker-compose.yml, so the R2 bucket must
# be created with exactly that name.
BRAINROT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BRAINROT_S3_ACCESS_KEY_ID=
BRAINROT_S3_SECRET_ACCESS_KEY=
BRAINROT_S3_REGION=auto
